# Copy this file to .env and fill in your values. .env is gitignored; never commit it.
# Both come from the Cloudflare dashboard: AI > Workers AI > Use REST API.

# Your Cloudflare account ID ("Get Account ID" on that page)
CLOUDFLARE_ACCOUNT_ID=

# A Workers AI API token ("Create a Workers AI API Token"); needs Workers AI Read + Edit
CLOUDFLARE_API_TOKEN=

# Pollinations secret key (starts with sk_), from https://enter.pollinations.ai
# Only for drafts (--draft, --preview-scenes), the emergency backup when Cloudflare fails or the daily cap is reached,
# and brainstorming (--thumbnail-ideas, --style-test). Allow the key to use text models too.
POLLINATIONS_API_KEY=

# Optional: default --style for AI images (overrides style in make_video.toml; --style on the command line wins)
# VIDEO_STYLE=cinematic documentary, warm natural light

# Kaggle API token for the upscaling on every final render and --engine chatterbox (Kaggle > Settings > API Tokens > Generate New Token).
# The new-style token, not the legacy kaggle.json key.
KAGGLE_API_TOKEN=

# Optional: stock footage and photos (--media mixed / stock). Use either or both; free keys from
# https://www.pexels.com/api/ and https://pixabay.com/api/docs/ (sign in, the key is shown on the page).
PEXELS_API_KEY=
PIXABAY_API_KEY=
