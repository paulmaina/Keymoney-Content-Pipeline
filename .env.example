# Copy this file to .env and fill in your values. .env is gitignored; never commit it.
# Both come from the Cloudflare dashboard: AI > Workers AI > Use REST API.

# Your Cloudflare account ID ("Get Account ID" on that page)
CLOUDFLARE_ACCOUNT_ID=

# A Workers AI API token ("Create a Workers AI API Token"); needs Workers AI Read + Edit
CLOUDFLARE_API_TOKEN=

# Optional: Pollinations secret key (starts with sk_), from https://enter.pollinations.ai
# Used for images once Cloudflare's daily allowance runs out (--image-provider auto), or with
# --image-provider pollinations.
POLLINATIONS_API_KEY=

# Optional: default --style for AI images (overrides style in make_video.toml; --style on the command line wins)
# VIDEO_STYLE=3D animated film style, colourful, expressive characters

# Optional: Kaggle API token for --kaggle-video (Kaggle > Settings > API Tokens > Generate New Token).
# The new-style token, not the legacy kaggle.json key.
KAGGLE_API_TOKEN=
