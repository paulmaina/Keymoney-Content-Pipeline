# Copy this file to .env and fill in your values. .env is gitignored; never commit it.
# Both come from the Cloudflare dashboard: AI > Workers AI > Use REST API.

# Your Cloudflare account ID ("Get Account ID" on that page)
CLOUDFLARE_ACCOUNT_ID=

# A Workers AI API token ("Create a Workers AI API Token"); needs Workers AI Read + Edit
CLOUDFLARE_API_TOKEN=
